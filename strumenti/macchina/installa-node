#!/bin/bash
# installa-node <versione> — Node dal pacchetto ufficiale, verificato con
# SHASUMS256.txt, in una cartella per versione; /opt/node la indica.
# Ubuntu offre la 22, senza crypto.argon2 (§2.6). Una LTS pari.
set -euo pipefail
[ $# -eq 1 ] || { echo "uso: installa-node 24.21.0" >&2; exit 2; }
v=$1
[ "$(id -u)" -eq 0 ] || { echo "va lanciato con sudo" >&2; exit 2; }
nome="node-v$v-linux-x64"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cd "$tmp"
curl -fsSLO "https://nodejs.org/dist/v$v/$nome.tar.xz"
curl -fsSLO "https://nodejs.org/dist/v$v/SHASUMS256.txt"
grep " $nome.tar.xz\$" SHASUMS256.txt | sha256sum -c -
tar -xJf "$nome.tar.xz" -C /opt
chown -R root:root "/opt/$nome"
ln -sfn "/opt/$nome" /opt/node.nuovo
mv -T /opt/node.nuovo /opt/node
/opt/node/bin/node -e 'const c=require("node:crypto"); if(!c.argon2) throw new Error("niente argon2"); console.log(process.version, "argon2 c\x27e\x27")'
